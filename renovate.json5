{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["config:recommended"],
  customManagers: [
    {
      customType: "regex",
      description: "Track Go tools installed with `go install <module>/cmd/...@vX` in workflow run steps, which no built-in manager parses.",
      managerFilePatterns: ["/^\\.github/workflows/.+\\.ya?ml$/"],
      matchStrings: [
        "go install (?<depName>golang\\.org/x/(?:tools|vuln))/cmd/[a-z]+@(?<currentValue>v[\\d.]+)",
      ],
      datasourceTemplate: "go",
    },
  ],
  packageRules: [
    {
      description: "Renovate treats the go.mod `go` directive as a minimum and does not propose updates to it by default, so the golang image moved ahead of it alone. Bump it so it moves with the go-toolchain group. setup-go reads it through go-version-file, so this also sets the CI Go version.",
      matchManagers: ["gomod"],
      matchDepNames: ["go"],
      matchDepTypes: ["golang"],
      rangeStrategy: "bump",
    },
    {
      description: "Keep the Go toolchain and everything version-locked to it in one PR: the language version (go.mod directive + setup-go), the golang Docker image, golangci-lint, and the x/tools analyzers (deadcode, govulncheck). A Go bump that outpaces the tooling breaks CI — the SSA builder in deadcode and govulncheck panics on new syntax and golangci-lint hits typecheck errors on the new stdlib. Grouping forces CI to validate the whole set together instead of merging them piecemeal.",
      groupName: "go-toolchain",
      matchDepNames: [
        "go",
        "golang",
        "golangci/golangci-lint",
        "golang.org/x/tools",
        "golang.org/x/vuln",
      ],
    },
    {
      description: "The chart pins step-ca 0.30.2 behaviour (webhooks, CRL, templates) that AuthStep relies on; review step-certificates updates together with the step-ca image used in dev scripts.",
      groupName: "step-ca",
      matchDepNames: ["step-certificates", "smallstep/step-ca"],
    },
  ],
}
